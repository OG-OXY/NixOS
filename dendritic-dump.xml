local Monitor2 = "desc:Dell Inc. DELL P2720D K6RX299P10LS"

---- MONITORS ----
-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
hl.monitor({
  output = Monitor1,
  mode = "1920x1080@240",
  position = "0x0",
  scale = "1",
})

hl.monitor({
  output = Monitor2,
  mode = "2560x1440p@59",
  position = "1920x-180",
  scale = "1",
})


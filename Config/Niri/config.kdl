// ~/.config/niri/config.kdl

spawn-at-startup "uwsm" "finalize"
spawn-at-startup "ghostty" "-e" "herdr"
spawn-at-startup "zen-beta"
spawn-at-startup "vesktop"
spawn-at-startup "obsidian"

// Already Set In ==> sessionVariables, Redundant?
environment {
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    LIBVA_DRIVER_NAME "nvidia"
    NVD_BACKEND "direct"
}

// Keeps games at native 1:1 pixel grid
xwayland-satellite {
}

input {
    focus-follows-mouse max-scroll-amount="0%"
    keyboard {
        // If you change any of this make sure you change them in keyboard.nix
        // Perfect or maybe a little lower? 40?
        repeat-rate 45
        // Set to anywhere between 275 and 295 (285/290 perfect? maybe 295?)
        repeat-delay 285
        xkb {
            layout "us"
        }
    }
    mouse {
        accel-profile "flat"
        accel-speed 0.0
        // natural-scroll
    }
}

cursor {
    xcursor-theme "Saturn"
    xcursor-size 24
}

output "ASUSTek COMPUTER INC ROG PG258Q #ASP9OUVfHcfd" {
    mode "1920x1080@240.000"
    position x=0 y=0
    scale 1.0
    variable-refresh-rate
}

output "Dell Inc. DELL P2720D K6RX299P10LS" {
    mode "2560x1440@59.951"
    position x=1920 y=-180
    scale 1.185
}

layout {
    gaps 0
    background-color "transparent"
    center-focused-column "never"
    default-column-display "tabbed"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66666
    }
    focus-ring {
        width 0
        active-color "rgba(33, 204, 255, 0.93)"
        inactive-color "rgba(89, 89, 89, 0.67)"
    }
    border {
        on
        width 7
        // Comment Out All Color Settings For Original Yellow-Orange Borders
        // Most Orange Borders
        active-color "rgba(255, 115, 0, 0.93)"
        inactive-color "rgba(89, 89, 89, 0.67)"
        // Nice Orange Borders
        //active-color "rgba(255, 140, 0, 0.93)"
        //inactive-color "rgba(89, 89, 89, 0.67)"
        // Red Borders
        //active-color "rgba(255, 60, 60, 0.93)"
        //inactive-color "rgba(89, 89, 89, 0.67)"
    }
    struts {
        top 0
        bottom 0
        left 0
        right 0
    }
}

overview {
  backdrop-color "#ff7300"
  workspace-shadow {
    on
  }
}

animations {
    slowdown 1.0
}

window-rule {
    match app-id="^$" title="^$"
    open-floating true
    geometry-corner-radius 0
    clip-to-geometry true
    background-effect {
      blur true
      xray false
    }
}

window-rule {
    // Match games running via Steam or Wine/Proton
    match app-id=r#"^steam_app_.*"#
    // Forces the window to receive unscaled geometry directly
    default-column-width { }
}

recent-windows {
  binds {
    Mod+R { next-window scope="output"; }
    Mod+E { previous-window scope="output"; }
  }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    // Core Program Launchers & Actions
    Mod+Space { spawn "apps"; }
    Mod+D { spawn "warp"; }

    // Layout Controls & Sizing
    Mod+X { center-column; }
    Mod+F { maximize-column; }
    Mod+M { maximize-window-to-edges; }
    Mod+Shift+M { fullscreen-window; }
    Mod+Comma { switch-preset-column-width; }
    Mod+Slash { switch-preset-column-width-back; }
    // Mod+Slash { expand-column-to-available-width; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+Z { toggle-column-tabbed-display; }
    Mod+Q repeat=false { toggle-overview; }
    Mod+C repeat=false { close-window; }
    
    // Column Splitting & Window Consumption (VI Integration)
 
    Mod+Y { consume-window-into-column; }
    Mod+P { expel-window-from-column; }
    // Both Current Focus Oriented
    Mod+B { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // VI Movement & Focus (H/J/K/L)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // Monitor Focus & Movement
    Mod+G { focus-monitor-left; }
    Mod+Semicolon { focus-monitor-right; }

    // Window/Column Reordering (Mod+Shift+G/H/J/K/L/Semicolon)
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+G { move-column-to-monitor-left; }
    Mod+Shift+Semicolon { move-column-to-monitor-right; }

    // Workspace Management (VI + Number Defaults)
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+U { move-workspace-down; }
    Mod+Shift+Ctrl+I { move-workspace-up; }
    Mod+W { focus-workspace-previous; }

    // Mod+1 { focus-workspace 1; }
    // Mod+2 { focus-workspace 2; }
    // Mod+3 { focus-workspace 3; }
    // Mod+4 { focus-workspace 4; }
    // Mod+5 { focus-workspace 5; }
    // Mod+6 { focus-workspace 6; }
    // Mod+7 { focus-workspace 7; }
    // Mod+8 { focus-workspace 8; }
    // Mod+9 { focus-workspace 9; }

    // Mod+Shift+1 { move-column-to-workspace 1; }
    // Mod+Shift+2 { move-column-to-workspace 2; }
    // Mod+Shift+3 { move-column-to-workspace 3; }
    // Mod+Shift+4 { move-column-to-workspace 4; }
    // Mod+Shift+5 { move-column-to-workspace 5; }
    // Mod+Shift+6 { move-column-to-workspace 6; }
    // Mod+Shift+7 { move-column-to-workspace 7; }
    // Mod+Shift+8 { move-column-to-workspace 8; }
    // Mod+Shift+9 { move-column-to-workspace 9; }

    // Granular Column & Window Sizing (Home-row adjacent)
    Mod+A { set-column-width "-10%"; }
    Mod+S { set-column-width "+10%"; }
    Mod+Shift+A { set-window-height "-10%"; }
    Mod+Shift+S { set-window-height "+10%"; }

    // Mouse Controls & Scrolling
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }

    // Hardware & System (Natively Handled)
    Print { screenshot-window; }
    Alt+Print { screenshot-screen; }
    Ctrl+Print { screenshot; }
    XF86Calculator { spawn-sh "pkill qalculate-gtk || qalculate-gtk"; }

    // Multimedia Keys
    // Put "-l" "1" After "set-volume" On RaiseVolume To Set Max-Volume Limit. (1=100%, 1.5=150%)
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp  allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }

    // Session Control
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete { spawn "fish" "-c" "logout"; }
    Mod+Shift+P { power-off-monitors; }
}
